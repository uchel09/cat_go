            {
              "id": "utbk-1.pm.q001",
              "teks": "Jika f(x) = 2x + 3 dan g(x) = x^2 - 1, maka (g o f)(1) adalah:",
              "opsi": {
                "A": "22",
                "B": "24",
                "C": "25",
                "D": "26",
                "E": "28"
              },
              "jawabanBenar": "B",
              "pembahasan": "f(1) = 2(1) + 3 = 5. (g o f)(1) = g(5) = 5^2 - 1 = 25 - 1 = 24."
            },
            {
              "id": "utbk-1.pm.q002",
              "teks": "Peluang munculnya jumlah mata dadu sama dengan 7 dari pelemparan dua buah dadu bermata enam adalah:",
              "opsi": {
                "A": "1/6",
                "B": "1/12",
                "C": "5/36",
                "D": "7/36",
                "E": "1/4"
              },
              "jawabanBenar": "A",
              "pembahasan": "Pasangan jumlah 7: (1,6), (2,5), (3,4), (4,3), (5,2), (6,1) -> 6 kombinasi. Peluang = 6/36 = 1/6."
            },
            {
              "id": "utbk-1.pm.q003",
              "teks": "Sebuah segitiga siku-siku memiliki panjang alas 6 cm dan tinggi 8 cm. Panjang sisi miringnya adalah:",
              "opsi": {
                "A": "9 cm",
                "B": "10 cm",
                "C": "11 cm",
                "D": "12 cm",
                "E": "14 cm"
              },
              "jawabanBenar": "B",
              "pembahasan": "Tripel Pythagoras: c = akar(6^2 + 8^2) = akar(36 + 64) = akar(100) = 10 cm."
            }
          ]
